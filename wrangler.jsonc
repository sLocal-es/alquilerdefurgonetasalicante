{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-21",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "alquilerfurgonetasalicante",
	"main": "worker/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// Corre el worker antes de servir assets: activa el redirect canónico
		// (canonicalRedirect en worker/index.js) también para páginas estáticas.
		// _redirects no soporta redirects por dominio/scheme (doc oficial).
		"run_worker_first": true
	},
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "alquilerdefurgonetasalicante-leads",
			"database_id": "ebd5687a-0c99-4b48-8025-09361b9e5b68"
		}
	],
	"vars": {
		"BRAND_NAME": "Alquiler Furgonetas Alicante",
		"DOMAIN": "alquilerdefurgonetasalicante.es",
		"TO_EMAIL": "alquilerfurgonetasalicante@proton.me",
		"PHONE_DISPLAY": "645 81 89 44"
	},
	"unsafe": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1001",
				"limit": 5,
				"period": 60
			}
		]
	},
	"observability": {
		"enabled": true
	}
}
