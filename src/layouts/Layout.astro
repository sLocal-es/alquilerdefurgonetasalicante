---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
}

const { title, description, ogImage, canonical } = Astro.props;

const siteUrl = "https://alquilerfurgonetasalicante.es";
const currentUrl = `${siteUrl}${Astro.url.pathname}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonical || currentUrl} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:site_name" content="Alquiler Furgonetas Alicante" />
    <meta property="og:locale" content="es_ES" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    
    <!-- Structured Data - LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Alquiler Furgonetas Alicante",
      "description": "Alquiler de furgonetas baratas en Alicante. Precios desde 35€/día.",
      "url": siteUrl,
      "telephone": "+34 965 123 456",
      "email": "info@alquilerfurgonetasalicante.es",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Calle Ejemplo 123",
        "addressLocality": "Alicante",
        "postalCode": "03001",
        "addressCountry": "ES"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "38.3452",
        "longitude": "-0.4810"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "08:00",
          "closes": "20:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Saturday", "Sunday"],
          "opens": "09:00",
          "closes": "14:00"
        }
      ],
      "priceRange": "€€",
      "image": `${siteUrl}/favicon.svg`,
      "sameAs": [],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Alquiler de Furgonetas",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Alquiler Furgoneta Pequeña",
              "description": "Furgoneta pequeña 3-4m³, 600 kg de carga útil"
            },
            "price": "35",
            "priceCurrency": "EUR"
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Alquiler Furgoneta Mediana",
              "description": "Furgoneta mediana 6-7m³, 850 kg de carga útil"
            },
            "price": "45",
            "priceCurrency": "EUR"
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Alquiler Furgoneta Grande",
              "description": "Furgoneta grande 8-10m³, 1000 kg de carga útil"
            },
            "price": "55",
            "priceCurrency": "EUR"
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Alquiler Furgoneta Extra Grande",
              "description": "Furgoneta extra grande 12-15m³, 1300 kg de carga útil"
            },
            "price": "65",
            "priceCurrency": "EUR"
          }
        ]
      }
    })} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --primary: #ff6b00;
    --primary-dark: #e55a00;
    --secondary: #1a1a1a;
    --text: #333333;
    --text-light: #666666;
    --bg: #ffffff;
    --bg-alt: #f8f9fa;
    --border: #e0e0e0;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
    color: var(--text);
    line-height: 1.6;
    background: var(--bg);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  h1, h2, h3, h4 {
    color: var(--secondary);
    line-height: 1.2;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  h2 {
    font-size: 1.8rem;
    margin: 3rem 0 1.5rem;
  }

  h3 {
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
  }

  p {
    margin-bottom: 1rem;
  }

  a {
    color: var(--primary);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .btn {
    display: inline-block;
    background: var(--primary);
    color: white;
    padding: 12px 24px;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn:hover {
    background: var(--primary-dark);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 1.8rem;
    }
    h2 {
      font-size: 1.4rem;
    }
  }
</style>
