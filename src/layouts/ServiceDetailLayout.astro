---
import Layout from './Layout.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';

interface ServiceSpecs {
  capacity: string;
  dimensions_interior: string;
  dimensions_exterior: string;
  maxLoad: string;
  seats: string;
  consumption: string;
  emissions: string;
}

interface RelatedService {
  name: string;
  slug: string;
  icon: string;
  price: string;
}

interface Props {
  title: string;
  subtitle: string;
  description: string;
  price: string;
  vehicleType: string;
  breadcrumbLabel: string;
  image?: string;
  specs: ServiceSpecs;
  idealFor: string[];
  includes: string[];
  related: RelatedService[];
  metaTitle: string;
  metaDescription: string;
  product: {
    name: string;
    description: string;
    capacity: string;
    maxLoad: string;
    seats: string;
    price: string;
  };
}

const {
  title, subtitle, description, price, vehicleType, breadcrumbLabel, image,
  specs, idealFor, includes, related,
  metaTitle, metaDescription, product
} = Astro.props;
---

<Layout
  title={metaTitle}
  description={metaDescription}
  product={product}
>

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/#flota">Furgonetas</a>
        <span>/</span>
        <span>{breadcrumbLabel}</span>
      </nav>

      <div class="hero-content">
        <div class="hero-text">
          <h1>{title}</h1>
          <p class="hero-subtitle">{subtitle}</p>

          <div class="hero-price">
            <span class="price-from">Desde</span>
            <span class="price-amount">{price}</span>
            <span class="price-period">/día</span>
          </div>

          <div class="hero-features">
            <div class="feature">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span>{specs.capacity} capacidad</span>
            </div>
            <div class="feature">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span>{specs.maxLoad} carga útil</span>
            </div>
            <div class="feature">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span>{specs.seats}</span>
            </div>
          </div>

          <a href="#contacto" class="btn btn-primary btn-lg">Solicitar presupuesto</a>
        </div>

        <div class="hero-image">
          {image ? (
            <img
              src={image}
              alt={`${title} - ${specs.capacity}`}
              width="600"
              height="400"
              loading="eager"
              decoding="sync"
            />
          ) : (
            <div class="image-placeholder">
              <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 16H9m10 0h3v-3.15a1 1 0 0 0-.84-.99L16 11l-2.7-3.6a1 1 0 0 0-.8-.4H5.24a2 2 0 0 0-1.8 1.1l-.8 1.63A6 6 0 0 0 2 12.42V16h2"/>
                <circle cx="6.5" cy="16.5" r="2.5"/>
                <circle cx="16.5" cy="16.5" r="2.5"/>
              </svg>
              <p>{breadcrumbLabel}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Specs -->
  <section class="specs">
    <div class="container">
      <h2>Especificaciones técnicas</h2>

      <div class="specs-grid">
        <div class="spec-card">
          <div class="spec-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <path d="M3 9h18"/>
            </svg>
          </div>
          <div class="spec-info">
            <span class="spec-label">Volumen de carga</span>
            <span class="spec-value">{specs.capacity}</span>
          </div>
        </div>

        <div class="spec-card">
          <div class="spec-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v20M2 12h20"/>
            </svg>
          </div>
          <div class="spec-info">
            <span class="spec-label">Carga útil máxima</span>
            <span class="spec-value">{specs.maxLoad}</span>
          </div>
        </div>

        <div class="spec-card">
          <div class="spec-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
            </svg>
          </div>
          <div class="spec-info">
            <span class="spec-label">Plazas</span>
            <span class="spec-value">{specs.seats}</span>
          </div>
        </div>

        <div class="spec-card">
          <div class="spec-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M8 12h8"/>
            </svg>
          </div>
          <div class="spec-info">
            <span class="spec-label">Consumo</span>
            <span class="spec-value">{specs.consumption}</span>
          </div>
        </div>
      </div>

      <div class="dimensions">
        <h3>Dimensiones</h3>
        <div class="dimensions-grid">
          <div class="dimension">
            <span class="dim-label">Exterior</span>
            <span class="dim-value">{specs.dimensions_exterior}</span>
          </div>
          <div class="dimension">
            <span class="dim-label">Interior (zona carga)</span>
            <span class="dim-value">{specs.dimensions_interior}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Description -->
  <section class="description">
    <div class="container">
      <div class="desc-content">
        <h2>¿Para qué sirve la {breadcrumbLabel.toLowerCase()}?</h2>
        <p>{description}</p>

        <ul class="benefits-list">
          {idealFor.map((item) => (
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Includes -->
  <section class="includes">
    <div class="container">
      <h2>¿Qué incluye el alquiler?</h2>
      <div class="includes-grid">
        {includes.map((item) => (
          <div class="include-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Vehicles -->
  <section class="related">
    <div class="container">
      <h2>También te puede interesar</h2>
      <div class="related-grid">
        {related.map((item) => (
          <a href={`/${item.slug}/`} class="related-card">
            <div class="related-icon">{item.icon}</div>
            <h3>{item.name}</h3>
            <p>Desde {item.price}/día</p>
            <span class="related-link">Ver más →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="container">
      <h2>Preguntas frecuentes</h2>
      <FAQ vehicleType={vehicleType} />
    </div>
  </section>

  <!-- Contact -->
  <ContactForm vehicleType={vehicleType} />

</Layout>

<style>
  .hero {
    background: var(--color-dark-bg);
    color: var(--color-dark-fg);
    padding: 4rem 0 6rem;
    clip-path: ellipse(120% 100% at 50% 100%);
  }

  .breadcrumb {
    font-size: 0.9rem;
    margin-bottom: 2rem;
    opacity: 0.8;
  }

  .breadcrumb a {
    color: var(--color-dark-fg);
  }

  .breadcrumb span {
    margin: 0 0.5rem;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero h1 {
    color: var(--color-dark-fg);
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    opacity: 0.9;
    margin-bottom: 1.5rem;
    line-height: var(--leading-body);
    color: var(--color-dark-fg-muted);
  }

  .hero-price {
    background: rgba(var(--color-primary-rgb), 0.2);
    padding: 1rem 1.5rem;
    border-radius: var(--radius-lg);
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  .price-from {
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .price-amount {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0.25rem;
  }

  .price-period {
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .hero-features {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .feature {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--color-dark-fg);
  }

  .feature svg {
    color: var(--color-primary);
  }

  .btn-lg {
    padding: 16px 32px;
    font-size: 1.1rem;
  }

  .hero-image {
    display: flex;
    justify-content: center;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-3xl);
    object-fit: cover;
    aspect-ratio: 3 / 2;
  }

  .image-placeholder {
    background: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-3xl);
    padding: 3rem;
    text-align: center;
  }

  .image-placeholder svg {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .image-placeholder p {
    margin: 0;
    font-weight: 600;
    color: var(--color-dark-fg);
  }

  .specs {
    padding: var(--section-py) 0;
    background: var(--color-bg-white);
  }

  .specs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .spec-card {
    background: var(--color-warm-bg);
    padding: 1.5rem;
    border-radius: var(--radius-2xl);
    text-align: center;
  }

  .spec-icon {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .spec-label {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--color-fg-muted);
    margin-bottom: 0.25rem;
  }

  .spec-value {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-fg);
  }

  .dimensions {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .dimensions h3 {
    margin-bottom: 1rem;
  }

  .dimensions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .dimension {
    background: var(--color-warm-bg);
    padding: 1rem 1.5rem;
    border-radius: var(--radius-lg);
  }

  .dim-label {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--color-fg-muted);
    margin-bottom: 0.25rem;
  }

  .dim-value {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-fg);
  }

  .description {
    padding: var(--section-py) 0;
    background: var(--color-warm-bg);
  }

  .desc-content {
    max-width: 800px;
  }

  .desc-content h2 {
    margin-top: 0;
  }

  .desc-content p {
    font-size: 1.1rem;
    line-height: var(--leading-body);
  }

  .benefits-list {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
  }

  .benefits-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .benefits-list li:last-child {
    border-bottom: none;
  }

  .benefits-list svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .includes {
    padding: var(--section-py) 0;
    background: var(--color-bg-white);
  }

  .includes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }

  .include-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    background: var(--color-warm-bg);
    border-radius: var(--radius-lg);
  }

  .include-item svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .faq {
    padding: var(--section-py) 0;
    background: var(--color-warm-bg);
  }

  @media (max-width: 768px) {
    .hero-content {
      grid-template-columns: 1fr;
    }

    .hero-image {
      display: none;
    }

    .specs-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .dimensions-grid {
      grid-template-columns: 1fr;
    }

    .includes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
