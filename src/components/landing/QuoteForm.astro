---
import {
  CARNET_OPTIONS,
  DURATIONS,
  OTHER_ZONE,
  SERVICES,
  TIME_SLOTS,
  todayIso,
} from '../../utils/lead-schema';
import '../../styles/global.css';

/** Los datos de cada vehículo que el paso 1 necesita renderizar. */
interface QuoteService {
  slug: string;
  name: string;
  capacity: string;
  price: string;
}

interface Props {
  /** Servicios (vehículos) del paso 1; el slug enlaza con su página de detalle. */
  services: QuoteService[];
  /** Zonas de recogida del select; el worker no las filtra por lista. */
  zones: string[];
  /** vehicleType de la página de detalle ("pequeña", "extra grande", …); preselecciona el tipo. */
  preselectVehicle?: string;
}

const { services, zones, preselectVehicle } = Astro.props;
const types = services.map((service) => service.slug);

// El vehicleType de la página de detalle se mapea al slug del service, igual
// que hacen las tarjetas de flota del engine con [data-quote-type]: el select
// `tipo` toma el slug como valor. Sin coincidencia exacta, no preselecciona.
const preselectedSlug = preselectVehicle
  ? `furgoneta-${preselectVehicle.trim().toLowerCase().replace(/\s+/g, '-')}-alicante`
  : undefined;
const preselected =
  preselectedSlug && services.some((service) => service.slug === preselectedSlug)
    ? preselectedSlug
    : undefined;
---

<section class="contact-section" id="contacto">
  <div class="container">
    <div
      class="quote-card"
      id="presupuesto"
      data-quote-form
      data-types={JSON.stringify(types)}
      data-zones={JSON.stringify(zones)}
    >
      <div class="form-top">
        <div>
          <h2>Solicita tu presupuesto sin compromiso</h2>
          <p>
            ¿Necesitas una furgoneta en Alicante? Cuéntanos qué necesitas y te enviaremos un presupuesto adaptado a
            tus necesidades en menos de 1 hora.
          </p>
        </div>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect>
          <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
          <path d="M12 11h4"></path>
          <path d="M12 16h4"></path>
          <path d="M8 11h.01"></path>
          <path d="M8 16h.01"></path>
        </svg>
      </div>

      <div class="step-bars" aria-hidden="true">
        <div class="step-bar active" data-step-bar="1"></div>
        <div class="step-bar" data-step-bar="2"></div>
      </div>
      <p class="step-label" aria-live="polite" data-step-label>Paso 1 de 2 · Tu alquiler</p>

      <form novalidate data-form>
        <div hidden data-step-panel="1">
          <div class="form-grid">
            <div class="field field-full">
              <label for="servicio">¿Qué servicio necesitas? <span>(opcional)</span></label>
              <select id="servicio" name="servicio" autocomplete="off">
                <option value="">Selecciona el servicio</option>
                {SERVICES.map((service) => <option value={service}>{service}</option>)}
              </select>
              <p class="field-error" id="servicio-error" data-error="servicio" hidden></p>
            </div>
            <div class="field field-full">
              <label for="tipo">Tipo de furgoneta *</label>
              <select id="tipo" name="tipo" required>
                <option value="">Selecciona un tamaño</option>
                {
                  services.map((service) => (
                    <option value={service.slug} selected={service.slug === preselected}>
                      {service.name.replace('Furgoneta ', '')} ({service.capacity}) - Desde {service.price}/día
                    </option>
                  ))
                }
              </select>
              <p class="field-error" id="tipo-error" data-error="tipo" hidden></p>
            </div>
            <div class="field field-full">
              <label for="zona">Zona de recogida *</label>
              <select id="zona" name="zona" required autocomplete="address-level2">
                <option value="">Selecciona tu municipio</option>
                {zones.map((zone) => <option value={zone}>{zone}</option>)}
                <option value={OTHER_ZONE}>{OTHER_ZONE}</option>
              </select>
              <p class="field-error" id="zona-error" data-error="zona" hidden></p>
            </div>
            <div class="field">
              <label for="fecha">Fecha de recogida</label>
              <input id="fecha" name="fecha" type="date" min={todayIso()} />
              <p class="field-error" id="fecha-error" data-error="fecha" hidden></p>
            </div>
            <div class="field">
              <label for="franja">Franja de recogida</label>
              <select id="franja" name="franja">
                <option value="">Selecciona…</option>
                {TIME_SLOTS.map((slot) => <option value={slot}>{slot}</option>)}
              </select>
              <p class="field-error" id="franja-error" data-error="franja" hidden></p>
            </div>
          </div>
        </div>

        <div hidden data-step-panel="2">
          <div class="form-grid">
            <div class="field field-full">
              <label for="duracion">Duración estimada <span>(opcional)</span></label>
              <select id="duracion" name="duracion">
                <option value="">Selecciona…</option>
                {DURATIONS.map((duration) => <option value={duration}>{duration}</option>)}
              </select>
              <p class="field-error" id="duracion-error" data-error="duracion" hidden></p>
            </div>
            <div class="field field-full">
              <label for="nombre">Nombre completo *</label>
              <input id="nombre" name="nombre" autocomplete="name" maxlength="100" required placeholder="Tu nombre" />
              <p class="field-error" id="nombre-error" data-error="nombre" hidden></p>
            </div>
            <div class="field">
              <label for="telefono">Teléfono *</label>
              <input
                id="telefono"
                name="telefono"
                type="tel"
                inputmode="tel"
                autocomplete="tel"
                maxlength="30"
                required
                placeholder="600 123 456"
              />
              <p class="field-error" id="telefono-error" data-error="telefono" hidden></p>
            </div>
            <div class="field">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" autocomplete="email" maxlength="255" required placeholder="tu@email.com" />
              <p class="field-error" id="email-error" data-error="email" hidden></p>
            </div>
            <div class="field field-full">
              <label for="carnet">¿Tienes carnet B con 2 años o más? *</label>
              <select id="carnet" name="carnet" required>
                <option value="">Selecciona una opción</option>
                {CARNET_OPTIONS.map((option) => <option value={option}>{option}</option>)}
              </select>
              <p class="field-error" id="carnet-error" data-error="carnet" hidden></p>
            </div>
            <div class="field field-full">
              <label for="detalles">Cuéntanos más detalles <span>(opcional)</span></label>
              <textarea
                id="detalles"
                name="detalles"
                maxlength="2000"
                placeholder="¿Qué necesitas transportar? ¿De dónde a dónde? Cuantos más detalles, mejor presupuesto te haremos."></textarea>
              <p class="field-error" id="detalles-error" data-error="detalles" hidden></p>
            </div>
          </div>
          <label class="consent-label" for="consentimiento">
            <input id="consentimiento" name="consentimiento" type="checkbox" required />
            <span>
              He leído y acepto la
              <a href="/politica-de-privacidad/" target="_blank" rel="noopener noreferrer">política de privacidad</a> y
              los <a href="/terminos-y-condiciones/" target="_blank" rel="noopener noreferrer">términos y condiciones</a>.
            </span>
          </label>
          <p class="field-error" id="consentimiento-error" data-error="consentimiento" hidden></p>
        </div>

        <div class="honeypot" aria-hidden="true">
          <label for="web">Web</label>
          <input id="web" name="web" tabindex="-1" autocomplete="off" />
        </div>

        <p class="field-error" role="alert" data-form-error hidden></p>

        <div class="form-buttons">
          <button class="btn btn-outline" type="button" data-back hidden>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m12 19-7-7 7-7"></path>
              <path d="M19 12H5"></path>
            </svg>
            Atrás
          </button>
          <button class="btn btn-primary submit-button" type="submit" data-submit>
            <span data-submit-label>Continuar</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </button>
        </div>
        <div class="form-bottom">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          Te responderemos en menos de 1 hora durante horario laboral. Sin compromiso.
        </div>
      </form>

      <template data-success-template>
        <div class="success-panel" role="status" tabindex="-1">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
          <h2>¡Solicitud enviada!</h2>
          <p>
            Hemos recibido tu petición. Te contactaremos en menos de 1 hora con tu presupuesto personalizado.
          </p>
          <button class="btn btn-primary" type="button" data-restart>
            Hacer otra solicitud
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </template>
    </div>
  </div>
</section>

<script>
  import { buildLeadSchema, durationRequired, STEP_ONE_FIELDS } from '../../utils/lead-schema';

  const root = document.querySelector<HTMLElement>('[data-quote-form]');
  const form = root?.querySelector<HTMLFormElement>('form');

  if (root && form) {
    // Alias con el tipo ya estrechado: las funciones declaradas más abajo no
    // conservan el narrowing del `if`.
    const formElement = form;
    const types = JSON.parse(root.dataset.types ?? '[]') as string[];
    const zones = JSON.parse(root.dataset.zones ?? '[]') as string[];
    const schema = buildLeadSchema({ types, zones });

    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-step-panel]'));
    const bars = Array.from(root.querySelectorAll<HTMLElement>('[data-step-bar]'));
    const stepLabel = root.querySelector<HTMLElement>('[data-step-label]');
    const submitButton = root.querySelector<HTMLButtonElement>('[data-submit]');
    const submitLabel = root.querySelector<HTMLElement>('[data-submit-label]');
    const backButton = root.querySelector<HTMLButtonElement>('[data-back]');
    const formError = root.querySelector<HTMLElement>('[data-form-error]');
    const successTemplate = root.querySelector<HTMLTemplateElement>('[data-success-template]');

    let step = 1;

    const fieldNames = [
      'servicio',
      'tipo',
      'zona',
      'fecha',
      'franja',
      'duracion',
      'nombre',
      'telefono',
      'email',
      'carnet',
      'detalles',
      'consentimiento',
    ];

    function collect(): Record<string, string | boolean> {
      const data = new FormData(formElement);
      return {
        servicio: String(data.get('servicio') ?? ''),
        tipo: String(data.get('tipo') ?? ''),
        zona: String(data.get('zona') ?? ''),
        fecha: String(data.get('fecha') ?? ''),
        franja: String(data.get('franja') ?? ''),
        duracion: String(data.get('duracion') ?? ''),
        nombre: String(data.get('nombre') ?? ''),
        telefono: String(data.get('telefono') ?? ''),
        email: String(data.get('email') ?? ''),
        carnet: String(data.get('carnet') ?? ''),
        detalles: String(data.get('detalles') ?? ''),
        consentimiento: data.get('consentimiento') === 'on',
        web: String(data.get('web') ?? ''),
      };
    }

    function clearErrors() {
      for (const name of fieldNames) {
        const error = root?.querySelector<HTMLElement>(`[data-error="${name}"]`);
        const input = root?.querySelector<HTMLElement>(`[name="${name}"]`);
        if (error) {
          error.textContent = '';
          error.hidden = true;
        }
        if (input) {
          input.removeAttribute('aria-invalid');
          input.removeAttribute('aria-describedby');
        }
      }
      if (formError) {
        formError.textContent = '';
        formError.hidden = true;
      }
    }

    function showErrors(errors: Record<string, string>) {
      for (const [name, message] of Object.entries(errors)) {
        const error = root?.querySelector<HTMLElement>(`[data-error="${name}"]`);
        const input = root?.querySelector<HTMLElement>(`[name="${name}"]`);
        if (error) {
          error.textContent = message;
          error.hidden = false;
        }
        if (input) {
          input.setAttribute('aria-invalid', 'true');
          input.setAttribute('aria-describedby', `${name}-error`);
        }
      }
    }

    function validate(names: readonly string[]): boolean {
      const result = schema.safeParse(collect());
      if (result.success) return true;

      const errors: Record<string, string> = {};
      for (const issue of result.error.issues) {
        const key = String(issue.path[0] ?? '');
        if (!names.includes(key) || errors[key]) continue;
        errors[key] = issue.message;
      }
      showErrors(errors);
      return Object.keys(errors).length === 0;
    }

    function setStep(next: number) {
      step = next;
      panels.forEach((panel, index) => {
        panel.hidden = index !== next - 1;
      });
      bars.forEach((bar, index) => {
        bar.classList.toggle('active', index < next);
      });
      if (stepLabel) {
        stepLabel.textContent = `Paso ${step} de 2 · ${step === 1 ? 'Tu alquiler' : 'Tus datos'}`;
      }
      if (backButton) backButton.hidden = step !== 2;
      if (submitLabel) {
        submitLabel.textContent = step === 1 ? 'Continuar' : 'Enviar solicitud';
      }
      clearErrors();
    }

    function scrollToForm() {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      root?.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block: 'start' });
    }

    backButton?.addEventListener('click', () => {
      setStep(1);
      root?.querySelector<HTMLElement>('[name="tipo"]')?.focus();
    });

    // Los botones de las tarjetas de la flota pueden preseleccionar el tipo
    // de furgoneta y llevar al formulario con [data-quote-type].
    for (const trigger of document.querySelectorAll<HTMLElement>('[data-quote-type]')) {
      trigger.addEventListener('click', () => {
        const select = root?.querySelector<HTMLSelectElement>('[name="tipo"]');
        if (select && trigger.dataset.quoteType) select.value = trigger.dataset.quoteType;
        setStep(1);
        scrollToForm();
        root?.querySelector<HTMLElement>('[name="zona"]')?.focus();
      });
    }

    formElement.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();

      if (step === 1) {
        if (!validate(STEP_ONE_FIELDS)) return;
        setStep(2);
        scrollToForm();
        root?.querySelector<HTMLElement>('[name="nombre"]')?.focus();
        return;
      }

      if (!validate(fieldNames)) {
        // Si el error está en el paso 1, se vuelve atrás para corregirlo.
        const firstStepOneError = STEP_ONE_FIELDS.find((name) =>
          root?.querySelector<HTMLElement>(`[data-error="${name}"]`)?.hidden === false,
        );
        if (firstStepOneError) {
          setStep(1);
          root?.querySelector<HTMLElement>(`[name="${firstStepOneError}"]`)?.focus();
        }
        return;
      }

      const values = collect();
      const params = new URLSearchParams(window.location.search);
      const utm: Record<string, string> = {};
      for (const key of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid']) {
        const value = params.get(key);
        if (value) utm[key] = value.slice(0, 500);
      }

      if (submitButton) {
        submitButton.disabled = true;
      }
      if (submitLabel) submitLabel.textContent = 'Enviando…';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...values, utm, pagina: window.location.pathname }),
        });

        if (!response.ok) {
          const payload = (await response.json().catch(() => ({}))) as { error?: string };
          throw new Error(payload.error ?? 'No se ha podido enviar tu solicitud.');
        }

        if (successTemplate) {
          formElement.hidden = true;
          const stepLabelEl = root.querySelector<HTMLElement>('[data-step-label]');
          const stepBarsEl = root.querySelector<HTMLElement>('.step-bars');
          const formTopEl = root.querySelector<HTMLElement>('.form-top');
          if (stepLabelEl) stepLabelEl.hidden = true;
          if (stepBarsEl) stepBarsEl.hidden = true;
          if (formTopEl) formTopEl.hidden = true;
          root.append(successTemplate.content.cloneNode(true));
          const panel = root.querySelector<HTMLElement>('.success-panel');
          panel?.focus();
          panel?.querySelector<HTMLButtonElement>('[data-restart]')?.addEventListener('click', () => {
            formElement.reset();
            formElement.hidden = false;
            if (stepLabelEl) stepLabelEl.hidden = false;
            if (stepBarsEl) stepBarsEl.hidden = false;
            if (formTopEl) formTopEl.hidden = false;
            root.querySelector('.success-panel')?.remove();
            if (submitButton) submitButton.disabled = false;
            setStep(1);
            root.querySelector<HTMLElement>('[name="servicio"]')?.focus();
          });
        }
      } catch (error) {
        if (formError) {
          formError.textContent =
            error instanceof Error
              ? error.message
              : 'No se ha podido enviar tu solicitud. Tus datos siguen aquí; vuelve a intentarlo.';
          formError.hidden = false;
        }
        if (submitButton) {
          submitButton.disabled = false;
        }
        if (submitLabel) submitLabel.textContent = 'Enviar solicitud';
      }
    });

    // La duración pasa a ser obligatoria cuando el servicio es concreto.
    const serviceSelect = root.querySelector<HTMLSelectElement>('[name="servicio"]');
    const durationSelect = root.querySelector<HTMLSelectElement>('[name="duracion"]');
    const durationLabel = root.querySelector<HTMLElement>('label[for="duracion"]');
    if (serviceSelect && durationSelect && durationLabel) {
      const sync = () => {
        const required = durationRequired(serviceSelect.value);
        durationSelect.required = required;
        durationLabel.innerHTML = required
          ? 'Duración estimada *'
          : 'Duración estimada <span>(opcional)</span>';
      };
      serviceSelect.addEventListener('change', sync);
      sync();
    }

    // Los paneles arrancan ocultos en el HTML para no mostrar el paso 2 sin
    // JavaScript: se abre el paso 1 al inicializar.
    setStep(1);
  }
</script>
