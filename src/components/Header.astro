  </div>

  <nav id="mobile-menu" class="mobile-nav" hidden aria-label="Menú móvil">
    <a href="/">Inicio</a>
    <a href="/#flota">Flota</a>
    <a href="/alquiler-furgonetas-por-horas-alicante/">Por horas</a>
    <a href="/furgonetas-mudanzas-alicante/">Mudanzas</a>
    <a href="/furgonetas-reformas-construccion-alicante/">Reformas</a>
    <a href="/blog/">Blog</a>
    <div class="mobile-cta">
      <a href="tel:+34645818944" class="btn btn-outline">Llamar</a>
      <a href="https://wa.me/34645818944?text=Hola%2C%20quiero%20reservar%20una%20furgoneta%20en%20Alicante." class="btn btn-primary" target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </div>
  </nav>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.querySelector('.mobile-toggle');
    const menu = document.querySelector('.mobile-nav');
    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      const open = menu.hidden;
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        menu.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Abrir menú');
        btn.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (!menu.hidden && !e.target.closest('.site-header')) {
        menu.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Abrir menú');
      }
    });

    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Abrir menú');
      });
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--color-bg-white);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 2rem;
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-fg);
    flex-shrink: 0;
  }

  .logo-mark {
    width: 32px;
    height: 32px;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .primary-nav a {
    color: var(--color-fg);
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 500;
    position: relative;
    transition: color var(--duration-default) var(--ease-card-hover);
  }

  .primary-nav a:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .primary-nav a.active {
    color: var(--color-primary);
  }

  .primary-nav a.active::after {
    content: '';
    position: absolute;
    bottom: -20px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-primary);
    border-radius: 2px 2px 0 0;
  }

  .header-cta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .cta-call {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-fg);
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    transition: color var(--duration-default) var(--ease-card-hover);
  }

  .cta-call:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .btn-sm {
    padding: 8px 18px;
    font-size: 0.9rem;
  }

  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: var(--color-fg);
    border-radius: var(--radius-md);
    transition: background var(--duration-default) var(--ease-card-hover);
  }

  .mobile-toggle:hover {
    background: var(--color-warm-bg);
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: 1rem 0 1.5rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-white);
  }

  .mobile-nav a {
    display: block;
    padding: 0.875rem 1.5rem;
    color: var(--color-fg);
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 500;
    border-radius: var(--radius-md);
    transition: background var(--duration-default) var(--ease-card-hover);
  }

  .mobile-nav a:hover {
    background: var(--color-warm-bg);
    color: var(--color-primary);
    text-decoration: none;
  }

  .mobile-cta {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 1.5rem 0;
  }

  .mobile-cta .btn {
    flex: 1;
    text-align: center;
  }

  @media (max-width: 960px) {
    .header-inner {
      height: 56px;
      gap: 1rem;
    }

    .primary-nav,
    .header-cta {
      display: none;
    }

    .mobile-toggle {
      display: block;
    }

    .mobile-nav {
      display: flex;
    }

    .logo-text {
      font-size: 0.875rem;
    }
  }

  @media (max-width: 480px) {
    .logo-text {
      display: none;
    }
  }
</style>
