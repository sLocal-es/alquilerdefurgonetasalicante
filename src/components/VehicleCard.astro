---
interface Props {
  group: string;
  name: string;
  slug: string;
  capacity: string;
  dimensions: string;
  maxLoad: string;
  price: string;
  seats: string;
  description: string;
}

const { group, name, slug, capacity, dimensions, maxLoad, price, seats, description } = Astro.props;
---

<div class="vehicle-card">
  <div class="vehicle-header">
    <span class="vehicle-group">{group}</span>
    <h3 class="vehicle-name">{name}</h3>
  </div>
  
  <div class="vehicle-image">
    <div class="image-placeholder">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M14 16H9m10 0h3v-3.15a1 1 0 0 0-.84-.99L16 11l-2.7-3.6a1 1 0 0 0-.8-.4H5.24a2 2 0 0 0-1.8 1.1l-.8 1.63A6 6 0 0 0 2 12.42V16h2"/>
        <circle cx="6.5" cy="16.5" r="2.5"/>
        <circle cx="16.5" cy="16.5" r="2.5"/>
      </svg>
    </div>
  </div>
  
  <p class="vehicle-description">{description}</p>
  
  <div class="vehicle-specs">
    <div class="spec">
      <span class="spec-label">Capacidad</span>
      <span class="spec-value">{capacity}</span>
    </div>
    <div class="spec">
      <span class="spec-label">Carga máxima</span>
      <span class="spec-value">{maxLoad}</span>
    </div>
    <div class="spec">
      <span class="spec-label">Plazas</span>
      <span class="spec-value">{seats}</span>
    </div>
  </div>
  
  <div class="vehicle-price">
    <span class="price-from">Desde</span>
    <span class="price-amount">{price}</span>
    <span class="price-period">/día</span>
  </div>
  
  <a href={`/${slug}`} class="btn btn-primary">Ver detalles</a>
</div>

<style>
  .vehicle-card {
    background: var(--color-bg-white);
    border-radius: var(--radius-3xl);
    padding: 1.5rem;
    box-shadow: var(--shadow-card);
    transition: transform var(--duration-card) var(--ease-card-hover),
                box-shadow var(--duration-card) var(--ease-card-hover);
    display: flex;
    flex-direction: column;
  }

  .vehicle-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .vehicle-header {
    margin-bottom: 1rem;
  }

  .vehicle-group {
    display: inline-block;
    background: rgba(var(--color-primary-rgb), 0.12);
    color: var(--color-primary);
    padding: 4px 14px;
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .vehicle-name {
    font-size: 1.25rem;
    margin: 0;
  }

  .vehicle-image {
    background: var(--color-warm-bg);
    border-radius: var(--radius-lg);
    padding: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .image-placeholder {
    color: var(--color-fg-muted);
  }

  .vehicle-description {
    color: var(--color-fg-muted);
    font-size: 0.95rem;
    margin-bottom: 1rem;
    line-height: var(--leading-body);
  }

  .vehicle-specs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .spec {
    display: flex;
    flex-direction: column;
  }

  .spec-label {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
  }

  .spec-value {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-fg);
  }

  .vehicle-price {
    background: var(--color-warm-bg);
    padding: 1rem;
    border-radius: var(--radius-lg);
    text-align: center;
    margin-bottom: 1rem;
  }

  .price-from {
    font-size: 0.85rem;
    color: var(--color-fg-muted);
  }

  .price-amount {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .price-period {
    font-size: 0.85rem;
    color: var(--color-fg-muted);
  }

  .btn-primary {
    text-align: center;
  }

  @media (max-width: 480px) {
    .vehicle-specs {
      grid-template-columns: 1fr;
    }
  }
</style>
