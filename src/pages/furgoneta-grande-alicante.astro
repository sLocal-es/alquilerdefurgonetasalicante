---
import ServiceDetailLayout from '../layouts/ServiceDetailLayout.astro';

const specs = {
  capacity: "8-10m³",
  dimensions_interior: "3.00 x 1.70 x 1.70 m",
  dimensions_exterior: "5.40 x 2.00 x 2.40 m",
  maxLoad: "1000 kg",
  seats: "3 plazas",
  consumption: "7.0 - 7.5 L/100 km",
  emissions: "184 - 197 g/km"
};

const idealFor = [
  "Mudanzas de pisos grandes (3-4 habitaciones)",
  "Transporte de cargas pesadas y voluminosas",
  "Distribución comercial",
  "Reformas y obras grandes",
  "Eventos y montajes"
];

const includes = [
  "Seguro a todo riesgo con franquicia de 400€",
  "Asistencia en carretera 24h con vehículo de sustitución",
  "250 km diarios incluidos por su mayor autonomía",
  "Aire acondicionado bizona, pantalla táctil y sensores traseros",
  "Revisión técnica completa antes de cada alquiler",
  "Cámara de marcha atrás y kit de amarre profesional"
];

const description = `La furgoneta grande es la herramienta de trabajo definitiva para profesionales y mudanzas exigentes. Con 8-10m³ de capacidad y 1.000 kg de carga útil, te permite vaciar un piso de 3-4 habitaciones en un solo viaje. Sus 5.40 metros de largo y 2 metros de ancho ofrecen un volumen de carga que simplemente no consigues con furgonetas más pequeñas, pero sin llegar a las dimensiones de un camión que requiera permisos especiales.

Es la opción preferida por empresas de reformas, montaje de eventos y distribución comercial en Alicante. La amplitud interior permite cargar palés, maquinaria, muebles de gran tamaño como armarios de 3 cuerpos o sofás esquineros, y todo tipo de mercancía voluminosa. Además, sus 3 plazas delanteras permiten que viaje un equipo de hasta 3 personas, ideal para cuadrillas de trabajo.

A pesar de su tamaño, incorpora ayudas a la conducción como cámara de marcha atrás y sensores de aparcamiento que facilitan las maniobras. Su consumo de 7.0-7.5 L/100km es razonable para el volumen que ofrece. Si tu mudanza o proyecto requiere mover mucho volumen en pocos viajes, la furgoneta grande es la inversión que se amortiza en tiempo y gasolina.`;

const related = [
  { name: "Furgoneta Pequeña", slug: "furgoneta-pequeña-alicante", icon: "🚐", price: "35€" },
  { name: "Furgoneta Mediana", slug: "furgoneta-mediana-alicante", icon: "🚛", price: "45€" },
  { name: "Furgoneta Extra Grande", slug: "furgoneta-extra-grande-alicante", icon: "🏗️", price: "65€" }
];
---

<ServiceDetailLayout
  title="Alquiler Furgoneta Grande en Alicante"
  subtitle="Espaciosa y versátil para cargas voluminosas. La solución profesional para mudanzas grandes y transportes exigentes."
  description={description}
  price="55€"
  vehicleType="grande"
  breadcrumbLabel="Furgoneta Grande"
  image="/images/furgonetas/grande-hero.webp"
  specs={specs}
  idealFor={idealFor}
  includes={includes}
  related={related}
  metaTitle="Alquiler Furgoneta Grande en Alicante | Desde 55€/día"
  metaDescription="Alquiler de furgonetas grandes en Alicante. Capacidad 8-10m³, 1000 kg de carga. Ideal para mudanzas grandes. Precios desde 55€/día."
  product={{
    name: "Alquiler Furgoneta Grande en Alicante",
    description: "Furgoneta grande 8-10m³, 1000 kg de carga útil. Espaciosa y versátil para cargas voluminosas.",
    capacity: "8-10m³",
    maxLoad: "1000 kg",
    seats: "3 plazas",
    price: "55"
  }}
/>
