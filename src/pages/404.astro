---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada (404) | Furgonetas Alicante"
  description="La página que buscas no existe o se ha movido. Vuelve al inicio para encontrar alquiler de furgonetas en Alicante."
  noindex={true}
>
  <section class="not-found">
    <div class="container">
      <span class="eyebrow">Error 404</span>
      <h1>Página no encontrada</h1>
      <p class="not-found-text">
        Lo sentimos, la página que buscas no existe o se ha movido. Puedes volver al
        inicio para ver nuestras furgonetas disponibles o consultar el blog.
      </p>
      <div class="not-found-actions">
        <a href="/" class="btn">Volver al inicio</a>
        <a href="/blog/" class="not-found-link">Ver el blog</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding: var(--section-py-lg) 0;
    background: var(--color-bg-white);
    text-align: center;
  }

  .not-found h1 {
    margin-top: 0.75rem;
    margin-bottom: 1rem;
  }

  .not-found-text {
    font-size: 1.15rem;
    color: var(--color-fg-muted);
    max-width: 560px;
    margin: 0 auto 2rem;
    line-height: var(--leading-body);
  }

  .not-found-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .not-found-link {
    font-family: var(--font-heading);
    font-weight: 600;
  }
</style>
