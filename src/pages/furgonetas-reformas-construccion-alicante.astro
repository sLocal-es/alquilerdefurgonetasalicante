---
import Layout from '../layouts/Layout.astro';
import VehicleCard from '../components/VehicleCard.astro';

const vehicles = [
  {
    group: "Grupo B",
    name: "Furgoneta Mediana",
    slug: "furgoneta-mediana-alicante",
    capacity: "6-7m³",
    dimensions: "2.60 x 1.65 x 1.40 m",
    maxLoad: "850 kg",
    price: "45€",
    seats: "2-3 plazas",
    description: "Materiales ligeros y herramientas para pequeñas obras",
    image: "/images/furgonetas/mediana-card.webp"
  },
  {
    group: "Grupo C",
    name: "Furgoneta Grande",
    slug: "furgoneta-grande-alicante",
    capacity: "8-10m³",
    dimensions: "3.00 x 1.70 x 1.70 m",
    maxLoad: "1000 kg",
    price: "55€",
    seats: "3 plazas",
    description: "Buena capacidad y acceso para polígonos",
    image: "/images/furgonetas/grande-card.webp"
  },
  {
    group: "Grupo D",
    name: "Furgoneta Extra Grande",
    slug: "furgoneta-extra-grande-alicante",
    capacity: "12-15m³",
    dimensions: "3.70 x 1.76 x 1.85 m",
    maxLoad: "1300 kg",
    price: "65€",
    seats: "3 plazas",
    description: "La máxima capacidad para materiales voluminosos",
    image: "/images/furgonetas/extragrande-card.webp"
  }
];

const checklist = [
  "Medir ancho y alto de puertas, escaleras y accesos del portal.",
  "Proteger el habitáculo y envolver materiales sensibles a golpes o polvo.",
  "Calcular peso por viaje y respetar la carga útil indicada.",
  "Planificar hora de carga/descarga para no interrumpir otras obras o vecinos.",
  "Confirmar aparcamiento temporal o zona de carga en origen y destino."
];

const faqs = [
  {
    question: "¿Qué furgoneta conviene para transportar material de obra?",
    answer: "Para cargas ligeras y herramientas suele bastar la Mediana. Para volumen y materiales como azulejos, placas o perfiles, la Grande o Extra Grande, revisando peso y dimensiones."
  },
  {
    question: "¿La furgoneta soporta cargas pesadas de construcción?",
    answer: "Cada modelo tiene una carga útil máxima indicada. Es importante respetarla y repartir bien el peso, especialmente en azulejos, sacos y maquinaria pequeña."
  },
  {
    question: "¿Puedo usar la furgoneta para repartos y entregas profesionales?",
    answer: "Sí, la furgoneta de alquiler se adapta a repartos puntuales o refuerzos de flota. Consulta el grupo adecuado al volumen y la frecuencia."
  },
  {
    question: "¿Qué hacer si el material no cabe en una sola carga?",
    answer: "Conviene repartir por prioridad de instalación o dividir en viajes. Si el volumen es muy alto, la Extra Grande reduce viajes; también puedes consultar paquetes por días."
  }
];
---

<Layout
  title="Alquiler de Furgonetas para Reformas y Construcción en Alicante"
  description="Alquiler de furgonetas para reformas y construcción en Alicante. Transporte de materiales, herramientas y residuos, por horas y por días, sin conductor."
  breadcrumb={[
    { name: "Inicio", url: "/" },
    { name: "Reformas y construcción", url: "/furgonetas-reformas-construccion-alicante/" }
  ]}
>
  <section class="hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        <span>/</span>
        <span>Reformas y construcción</span>
      </nav>
      <span class="eyebrow">— Alquiler de Furgonetas para Reformas en Alicante</span>
      <h1>Alquiler de furgonetas para reformas y construcción en Alicante</h1>
      <p class="hero-subtitle">
        Transporta materiales, herramientas y residuos con la furgoneta adecuada. Sin conductor, con seguro
        incluido y reserva en menos de 1 hora.
      </p>
      <div class="hero-features">
        <div class="feature"><span>Para obra y reformas</span></div>
        <div class="feature"><span>Por horas y por días</span></div>
        <div class="feature"><span>Carnet B</span></div>
      </div>
      <a href="https://wa.me/34645818944?text=Hola%2C%20quiero%20reservar%20furgoneta%20para%20reforma%20o%20construcci%C3%B3n%20en%20Alicante." class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">
        Reservar para obra
      </a>
    </div>
  </section>

  <section class="content">
    <div class="container">
      <h2>Transporte de materiales y herramientas</h2>
      <p>
        Una reforma genera cargas variadas: azulejos, rodapiés, perfiles, herramientas eléctricas, sacos de
        mortero, pintura, embalaje y residuos. Una furgoneta de alquiler permite llevar lo necesario al ritmo
        de la obra, sin depender de una empresa externa para cada traslado.
      </p>
      <p>
        En Alicante y su área metropolitana, además del centro, los polígonos y zonas industriales son destinos
        habituales. Conviene planificar carga, descarga y aparcamiento, sobre todo con materiales voluminosos
        o sucios.
      </p>
    </div>
  </section>

  <section class="checklist">
    <div class="container">
      <h2>Consejos para cargar material de obra</h2>
      <ul>
        {checklist.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="vehicles">
    <div class="container">
      <h2>Furgonetas recomendadas para obra y reformas</h2>
      <p class="section-subtitle">Grupos recomendados según carga y espacio</p>
      <div class="vehicle-grid">
        {vehicles.map((vehicle) => (
          <VehicleCard {...vehicle} />
        ))}
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <h2>Preguntas frecuentes sobre alquiler para reformas</h2>
      <ul class="faq-list">
        {faqs.map((item) => (
          <li class="faq-item">
            <details open>
              <summary class="faq-question">{item.question}</summary>
              <p class="faq-answer">{item.answer}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bottom-cta">
    <div class="container">
      <h2>¿Necesitas una furgoneta para tu obra?</h2>
      <p>Háblanos de la carga, la zona y la fecha. Te confirmamos disponibilidad y precio por horas o días.</p>
      <a href="https://wa.me/34645818944?text=Hola%2C%20quiero%20reservar%20furgoneta%20para%20obra%20en%20Alicante." class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">
        Hablar por WhatsApp
      </a>
      <p class="also-link">
        ¿Es una mudanza? Consulta <a href="/furgonetas-mudanzas-alicante/">alquiler para mudanzas</a> o
        <a href="/alquiler-furgonetas-por-horas-alicante/">alquiler por horas en Alicante</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .container { max-width: 1100px; margin: 0 auto; padding: 0 1.25rem; }
  .hero { background: var(--color-dark-bg); color: var(--color-dark-fg); padding: 4rem 0 6rem; text-align: center; clip-path: ellipse(120% 100% at 50% 100%); }
  .breadcrumb { display: flex; justify-content: center; gap: 0.5rem; font-size: 0.85rem; color: var(--color-dark-fg-muted); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--color-dark-fg-muted); }
  h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); line-height: 1.15; margin: 0 0 1rem; color: var(--color-dark-fg); }
  .hero-subtitle { font-size: 1.25rem; opacity: 0.9; margin-bottom: 2rem; color: var(--color-dark-fg-muted); }
  .hero-features { display: flex; justify-content: center; gap: 1.5rem; margin-bottom: 2rem; flex-wrap: wrap; }
  .feature { background: rgba(255,255,255,0.08); padding: 0.5rem 1rem; border-radius: 9999px; font-weight: 600; }
  .eyebrow { display: block; font-weight: 600; color: var(--color-primary); margin-bottom: 0.5rem; }
  .content, .checklist, .vehicles, .faq-section, .bottom-cta { padding: 3rem 0; }
  h2 { font-size: 1.6rem; margin-bottom: 1rem; }
  ul { display: grid; gap: 0.75rem; padding-left: 1.25rem; }
  .vehicle-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .btn { display: inline-block; padding: 0.75rem 1.25rem; border-radius: 9999px; font-weight: 600; text-decoration: none; }
  .btn-primary { background: var(--color-primary); color: var(--color-primary-fg, #fff); }
  .btn-lg { padding: 0.9rem 1.6rem; }
  .also-link a { color: var(--color-primary); text-decoration: underline; }
  .faq-list { display: grid; gap: 1rem; padding-left: 0; list-style: none; }
  .faq-item details { border: 1px solid var(--color-border); border-radius: 12px; padding: 1rem 1.25rem; background: var(--color-bg-white); }
  .faq-question { font-weight: 600; cursor: pointer; }
  .faq-answer { color: var(--color-fg-muted); margin-top: 0.5rem; }
  @media (max-width: 640px) { .hero-features { flex-direction: column; align-items: center; } }
</style>
