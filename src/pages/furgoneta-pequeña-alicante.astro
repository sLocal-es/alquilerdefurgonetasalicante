---
import ServiceDetailLayout from '../layouts/ServiceDetailLayout.astro';

const specs = {
  capacity: "3-4m³",
  dimensions_interior: "1.82 x 1.55 x 1.24 m",
  dimensions_exterior: "4.40 x 1.88 x 1.88 m",
  maxLoad: "600 kg",
  seats: "2-3 plazas",
  consumption: "5.4 - 5.6 L/100 km",
  emissions: "136 - 170 g/km"
};

const idealFor = [
  "Mudanzas de habitación o piso pequeño",
  "Traslado de muebles y electrodomésticos",
  "Transporte de material de trabajo",
  "Entregas de paquetería",
  "Reformas y obras pequeñas"
];

const includes = [
  "Seguro a todo riesgo con franquicia",
  "Asistencia en carretera 24h",
  "200 km diarios incluidos",
  "Equipamiento básico (A/C, bluetooth)",
  "Revisión técnica antes del alquiler"
];

const related = [
  { name: "Furgoneta Mediana", slug: "furgoneta-mediana-alicante", icon: "🚛", price: "45€" },
  { name: "Furgoneta Grande", slug: "furgoneta-grande-alicante", icon: "🚚", price: "55€" },
  { name: "Furgoneta Extra Grande", slug: "furgoneta-extra-grande-alicante", icon: "🏗️", price: "65€" }
];
---

<ServiceDetailLayout
  title="Alquiler Furgoneta Pequeña en Alicante"
  subtitle="Ágil, versátil y bien organizada. Perfecta para el transporte de pequeñas cargas en entornos urbanos."
  price="35€"
  vehicleType="pequeña"
  breadcrumbLabel="Furgoneta Pequeña"
  image="/images/furgonetas/pequena-hero.webp"
  specs={specs}
  idealFor={idealFor}
  includes={includes}
  related={related}
  metaTitle="Alquiler Furgoneta Pequeña en Alicante | Desde 35€/día"
  metaDescription="Alquiler de furgonetas pequeñas en Alicante. Capacidad 3-4m³, 600 kg de carga. Ideal para mudanzas y traslados. Precios desde 35€/día."
  product={{
    name: "Alquiler Furgoneta Pequeña en Alicante",
    description: "Furgoneta pequeña 3-4m³, 600 kg de carga útil. Ágil y versátil para mudanzas y traslados urbanos.",
    capacity: "3-4m³",
    maxLoad: "600 kg",
    seats: "2-3 plazas",
    price: "35"
  }}
/>
