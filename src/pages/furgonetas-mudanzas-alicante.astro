---
import Layout from '../layouts/Layout.astro';
import VehicleCard from '../components/VehicleCard.astro';

const vehicles = [
  {
    group: "Grupo AM",
    name: "Furgoneta Pequeña",
    slug: "furgoneta-pequeña-alicante",
    capacity: "3-4m³",
    dimensions: "1.82 x 1.55 x 1.24 m",
    maxLoad: "600 kg",
    price: "35€",
    seats: "2-3 plazas",
    description: "Pocos muebles, cajas y enseres personales en un solo viaje",
    image: "/images/furgonetas/pequena-card.webp"
  },
  {
    group: "Grupo B",
    name: "Furgoneta Mediana",
    slug: "furgoneta-mediana-alicante",
    capacity: "6-7m³",
    dimensions: "2.60 x 1.65 x 1.40 m",
    maxLoad: "850 kg",
    price: "45€",
    seats: "2-3 plazas",
    description: "El equilibrio perfecto entre capacidad y maniobrabilidad",
    image: "/images/furgonetas/mediana-card.webp"
  },
  {
    group: "Grupo C",
    name: "Furgoneta Grande",
    slug: "furgoneta-grande-alicante",
    capacity: "8-10m³",
    dimensions: "3.00 x 1.70 x 1.70 m",
    maxLoad: "1000 kg",
    price: "55€",
    seats: "3 plazas",
    description: "Espaciosa para pisos de 2-3 habitaciones",
    image: "/images/furgonetas/grande-card.webp"
  },
  {
    group: "Grupo D",
    name: "Furgoneta Extra Grande",
    slug: "furgoneta-extra-grande-alicante",
    capacity: "12-15m³",
    dimensions: "3.70 x 1.76 x 1.85 m",
    maxLoad: "1300 kg",
    price: "65€",
    seats: "3 plazas",
    description: "La máxima capacidad para mudanzas completas",
    image: "/images/furgonetas/extragrande-card.webp"
  }
];

const faqs = [
  {
    question: "¿Cuántas cajas caben en una furgoneta de alquiler para mudanza?",
    answer: "Depende del modelo. La Pequeña admite pocas cajas y enseres; la Mediana y la Grande están pensadas para mudanzas reales de piso. Si nos dices el tipo de vivienda y los muebles principales, te recomendamos el tamaño justo para evitar viajes extra."
  },
  {
    question: "¿Necesito mucha experiencia al volante para una mudanza?",
    answer: "Todas nuestras furgonetas se conducen con el carnet B y las unidades grandes incluyen cámara trasera y sensores. Aun así, si nunca has conducido un vehículo alto, recomendamos practicar la maniobra de carga en un espacio ancho antes de salir a vías rápidas."
  },
  {
    question: "¿Se puede hacer una mudanza en un solo día?",
    answer: "Sí, la mayoría de mudanzas dentro de Alicante y su área metropolitana se cubren en un día con la furgoneta adecuada y una buena organización de cajas, desmontaje y carga."
  },
  {
    question: "¿Qué pasa si he subestimado el tamaño de la furgoneta?",
    answer: "Te recomendamos contar antes mesas, sofás y electrodomésticos grandes. Si aun así necesitas más capacidad, avísanos cuanto antes para reorganizar la reserva según disponibilidad."
  }
];
---

<Layout
  title="Alquiler de Furgonetas para Mudanzas en Alicante"
  description="Alquiler de furgonetas para mudanzas en Alicante. Grupos AM a D, por horas y por días, sin conductor y con carnet B. Presupuesto en menos de 1 hora."
  breadcrumb={[
    { name: "Inicio", url: "/" },
    { name: "Mudanzas", url: "/furgonetas-mudanzas-alicante/" }
  ]}
>
  <section class="hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        <span>/</span>
        <span>Mudanzas</span>
      </nav>
      <span class="eyebrow">— Alquiler de Furgonetas para Mudanzas en Alicante</span>
      <h1>Alquiler de furgonetas para mudanzas en Alicante</h1>
      <p class="hero-subtitle">
        Múdate por tu cuenta o con ayuda puntual: tú conduces, tú decides el tamaño y el tiempo. Sin conductor
        y con seguro incluido.
      </p>
      <div class="hero-features">
        <div class="feature"><span>Grupos AM a D</span></div>
        <div class="feature"><span>Por horas desde 4h</span></div>
        <div class="feature"><span>Carnet B</span></div>
      </div>
      <a href="https://wa.me/34645818944?text=Hola%2C%20quiero%20reservar%20furgoneta%20para%20una%20mudanza%20en%20Alicante." class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">
        Reservar para mudanza
      </a>
    </div>
  </section>

  <section class="content">
    <div class="container">
      <h2>Qué furgoneta conviene para tu mudanza</h2>
      <p>
        No todas las mudanzas necesitan el mismo vehículo. Una mudanza de habitación o estudio puede resolverse
        con una Pequeña; un piso de 2-3 habitaciones con muebles y electrodomésticos suele requerir Mediana o
        Grande; mudanzas completas o de oficina encajan mejor con Grande o Extra Grande.
      </p>
      <p>
        Además del tamaño, conviene planificar la carga: desmontar muebles, embalar por estancias y dejar las
        piezas pesadas para el final. Si la vivienda tiene escaleras o acceso estrecho, el tamaño y el
        itinerario de carga importan tanto como el volumen.
      </p>
    </div>
  </section>

  <section class="checklist">
    <div class="container">
      <h2>Checklist de preparación de la mudanza</h2>
      <ul>
        <li>Medir muebles grandes y anotarlos por orden de carga.</li>
        <li>Empaquetar por habitación y etiquetar cajas.</li>
        <li>Confirmar aparcamiento y acceso de carga en origen y destino.</li>
        <li>Planificar el desmontaje de camas y sofás antes de la llegada de la furgoneta.</li>
        <li>Elegir el grupo adecuado y reservar con antelación en fechas de alta demanda.</li>
      </ul>
    </div>
  </section>

  <section class="pricing">
    <div class="container">
      <h2>Precios base de furgonetas para mudanzas</h2>
      <p class="section-subtitle">Precios por día. Sujeto a disponibilidad y fecha.</p>
      <div class="vehicle-grid">
        {vehicles.map((vehicle) => (
          <VehicleCard {...vehicle} />
        ))}
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <h2>Preguntas frecuentes sobre mudanzas con furgoneta de alquiler</h2>
      <ul class="faq-list">
        {faqs.map((item) => (
          <li class="faq-item">
            <details open>
              <summary class="faq-question">{item.question}</summary>
              <p class="faq-answer">{item.answer}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bottom-cta">
    <div class="container">
      <h2>¿Listo para tu mudanza?</h2>
      <p>Cuéntanos el día, el origen, el destino y el volumen. Te confirmamos disponibilidad y precio en menos de 1 hora.</p>
      <a href="https://wa.me/34645818944?text=Hola%2C%20quiero%20reservar%20furgoneta%20para%20mudanza%20en%20Alicante." class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">
        Hablar por WhatsApp
      </a>
      <p class="also-link">
        ¿Solo necesitas unas horas? Consulta <a href="/alquiler-furgonetas-por-horas-alicante/">alquiler por horas en Alicante</a> o
        <a href="/furgonetas-reformas-construccion-alicante/">alquiler para reformas y construcción</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .container { max-width: 1100px; margin: 0 auto; padding: 0 1.25rem; }
  .hero { background: var(--color-dark-bg); color: var(--color-dark-fg); padding: 4rem 0 6rem; text-align: center; clip-path: ellipse(120% 100% at 50% 100%); }
  .breadcrumb { display: flex; justify-content: center; gap: 0.5rem; font-size: 0.85rem; color: var(--color-dark-fg-muted); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--color-dark-fg-muted); }
  h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); line-height: 1.15; margin: 0 0 1rem; color: var(--color-dark-fg); }
  .hero-subtitle { font-size: 1.25rem; opacity: 0.9; margin-bottom: 2rem; color: var(--color-dark-fg-muted); }
  .hero-features { display: flex; justify-content: center; gap: 1.5rem; margin-bottom: 2rem; flex-wrap: wrap; }
  .feature { background: rgba(255,255,255,0.08); padding: 0.5rem 1rem; border-radius: 9999px; font-weight: 600; }
  .eyebrow { display: block; font-weight: 600; color: var(--color-primary); margin-bottom: 0.5rem; }
  .content, .checklist, .pricing, .faq-section, .bottom-cta { padding: 3rem 0; }
  h2 { font-size: 1.6rem; margin-bottom: 1rem; }
  ul { display: grid; gap: 0.75rem; padding-left: 1.25rem; }
  .vehicle-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .btn { display: inline-block; padding: 0.75rem 1.25rem; border-radius: 9999px; font-weight: 600; text-decoration: none; }
  .btn-primary { background: var(--color-primary); color: var(--color-primary-fg, #fff); }
  .btn-lg { padding: 0.9rem 1.6rem; }
  .also-link a { color: var(--color-primary); text-decoration: underline; }
  .faq-list { display: grid; gap: 1rem; padding-left: 0; list-style: none; }
  .faq-item details { border: 1px solid var(--color-border); border-radius: 12px; padding: 1rem 1.25rem; background: var(--color-bg-white); }
  .faq-question { font-weight: 600; cursor: pointer; }
  .faq-answer { color: var(--color-fg-muted); margin-top: 0.5rem; }
  @media (max-width: 640px) { .hero-features { flex-direction: column; align-items: center; } }
</style>
