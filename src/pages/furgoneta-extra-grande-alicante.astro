---
import ServiceDetailLayout from '../layouts/ServiceDetailLayout.astro';

const specs = {
  capacity: "12-15m³",
  dimensions_interior: "3.70 x 1.76 x 1.85 m",
  dimensions_exterior: "6.00 x 2.20 x 2.60 m",
  maxLoad: "1300 kg",
  seats: "3 plazas",
  consumption: "8.5 - 9.2 L/100 km",
  emissions: "223 - 242 g/km"
};

const idealFor = [
  "Mudanzas de viviendas grandes",
  "Transporte profesional de mercancías",
  "Cargas excepcionalmente voluminosas",
  "Obras y reformas de gran envergadura",
  "Logística y distribución a gran escala"
];

const includes = [
  "Seguro a todo riesgo con franquicia de 500€",
  "Asistencia en carretera 24h prioritaria con grúa pesada",
  "300 km diarios incluidos para cubrir grandes desplazamientos",
  "Aire acondicionado bizona, pantalla táctil 10\" y navegador GPS",
  "Revisión técnica completa antes de cada alquiler",
  "Cámara 360°, sensores perimetrales y kit de amarre industrial"
];

const description = `La furgoneta extra grande es el buque insignia de nuestra flota. Con 12-15m³ de capacidad y 1.300 kg de carga útil, es la solución definitiva para mudanzas de viviendas grandes, transporte profesional de mercancías y cualquier proyecto logístico que requiera el máximo volumen de carga disponible en un vehículo que se puede conducir con carnet B.

Sus 6 metros de largo y 3.70 metros de interior útil permiten transportar cargas que ninguna otra furgoneta de nuestra flota puede asumir: mobiliario completo de oficina, maquinaria industrial, materiales de construcción para obras de gran envergadura, o el contenido íntegro de un chalet o vivienda unifamiliar en el menor número de viajes posible. Los 1.300 kg de carga útil soportan mercancía densa y pesada sin comprometer la seguridad.

Está equipada con cámara 360° y sensores perimetrales para facilitar las maniobras a pesar de sus dimensiones. Es la opción más rentable cuando necesitás mover mucho volumen en distancias largas, ya que evita tener que hacer varios viajes con una furgoneta más pequeña. Si tu proyecto requiere la máxima capacidad sin tener que recurrir a un camión con permisos especiales, la extra grande es la respuesta.`;

const related = [
  { name: "Furgoneta Pequeña", slug: "furgoneta-pequeña-alicante", icon: "🚐", price: "35€" },
  { name: "Furgoneta Mediana", slug: "furgoneta-mediana-alicante", icon: "🚛", price: "45€" },
  { name: "Furgoneta Grande", slug: "furgoneta-grande-alicante", icon: "🚚", price: "55€" }
];
---

<ServiceDetailLayout
  title="Alquiler Furgoneta Extra Grande en Alicante"
  subtitle="La máxima capacidad para mudanzas grandes y transportes profesionales. Potencia y espacio sin límites."
  description={description}
  price="65€"
  vehicleType="extra grande"
  breadcrumbLabel="Furgoneta Extra Grande"
  image="/images/furgonetas/extragrande-hero.webp"
  specs={specs}
  idealFor={idealFor}
  includes={includes}
  related={related}
  metaTitle="Alquiler Furgoneta Extra Grande en Alicante | Desde 65€/día"
  metaDescription="Alquiler de furgonetas extra grandes en Alicante. Capacidad 12-15m³, 1300 kg de carga. Para mudanzas grandes y transporte profesional. Precios desde 65€/día."
  product={{
    name: "Alquiler Furgoneta Extra Grande en Alicante",
    description: "Furgoneta extra grande 12-15m³, 1300 kg de carga útil. La máxima capacidad para mudanzas grandes.",
    capacity: "12-15m³",
    maxLoad: "1300 kg",
    seats: "3 plazas",
    price: "65"
  }}
/>
