---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/common/BlogCard.astro';
import { blogArticles } from './_blog-data';

const siteUrl = "https://alquilerdefurgonetasalicante.es";
const pageTitle = "Blog de alquiler de furgonetas en Alicante";
const pageDescription = "Consejos, guías y precios sobre alquiler de furgonetas en Alicante. Mudanzas por barrios, cobertura provincial y todo lo que necesitas saber antes de reservar.";

const articles = [...blogArticles].sort((a, b) => b.date.localeCompare(a.date));
---

<Layout
  title={`${pageTitle} | Furgonetas Alicante`}
  description={pageDescription}
  canonical={`${siteUrl}/blog/`}
  breadcrumb={[
    { name: 'Inicio', url: siteUrl },
    { name: 'Blog', url: `${siteUrl}/blog/` },
  ]}
>
  <section class="blog-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <span>Blog</span>
      </nav>
      <span class="eyebrow">Blog</span>
      <h1>{pageTitle}</h1>
      <p class="blog-intro">{pageDescription}</p>
    </div>
  </section>

  <section class="blog-list">
    <div class="container">
      <div class="blog-grid">
        {articles.map((article) => (
          <BlogCard article={article} />
        ))}
      </div>

      <div class="blog-cta">
        <p>¿Necesitas una furgoneta para tu próxima mudanza en Alicante?</p>
        <a href="/#contacto" class="btn">Solicitar presupuesto</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-hero {
    background: var(--color-dark-bg);
    color: var(--color-dark-fg);
    padding: 4rem 0 5rem;
    clip-path: ellipse(120% 100% at 50% 100%);
  }

  .blog-hero h1 {
    color: var(--color-dark-fg);
    margin: 0.5rem 0 1rem;
    max-width: 820px;
  }

  .blog-hero .eyebrow {
    color: var(--color-primary);
  }

  .breadcrumb {
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    opacity: 0.8;
  }

  .breadcrumb a {
    color: var(--color-dark-fg);
  }

  .breadcrumb span {
    margin: 0 0.5rem;
  }

  .blog-intro {
    font-size: 1.15rem;
    line-height: var(--leading-body);
    color: var(--color-dark-fg-muted);
    max-width: 720px;
    margin-bottom: 0;
  }

  .blog-list {
    padding: var(--section-py) 0;
    background: var(--color-bg-white);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .blog-cta {
    margin-top: 3rem;
    padding: 2rem;
    background: var(--color-warm-bg);
    border-radius: var(--radius-3xl);
    text-align: center;
  }

  .blog-cta p {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }
</style>
