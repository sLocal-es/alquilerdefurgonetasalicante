---
import ServiceDetailLayout from '../layouts/ServiceDetailLayout.astro';

const specs = {
  capacity: "6-7m³",
  dimensions_interior: "2.60 x 1.65 x 1.40 m",
  dimensions_exterior: "5.00 x 1.95 x 2.25 m",
  maxLoad: "850 kg",
  seats: "2-3 plazas",
  consumption: "6.2 - 6.8 L/100 km",
  emissions: "163 - 178 g/km"
};

const idealFor = [
  "Mudanzas de pisos de 2-3 habitaciones",
  "Transporte de muebles grandes",
  "Cargas medianas y voluminosas",
  "Distribución de mercancía",
  "Reformas y obras medianas"
];

const includes = [
  "Seguro a todo riesgo con franquicia de 300€",
  "Asistencia en carretera 24h con grúa incluida",
  "200 km diarios incluidos con paquetes extra disponibles",
  "Aire acondicionado dual, bluetooth y control de crucero",
  "Revisión técnica completa antes de cada alquiler",
  "Kit de amarre con cinchas y mantas de protección"
];

const description = `La furgoneta mediana es nuestra opción más versátil y la favorita de nuestros clientes habituales. Con 6-7m³ de capacidad y 850 kg de carga útil, ofrece el equilibrio perfecto entre espacio de carga y facilidad de conducción. Mide 5 metros de largo, lo que la hace manejable tanto en ciudad como en carretera, pero con suficiente volumen interior para afrontar la mayoría de mudanzas domésticas.

Es la elección ideal para mudanzas de pisos de 2-3 habitaciones. En un solo viaje puedes cargar sofás de 2-3 plazas, neveras, lavadoras, armarios desmontados, colchones y todas las cajas de una mudanza media. También es muy utilizada por autónomos y pequeños comercios para distribución de mercancía, ya que combina buena capacidad con un consumo moderado de 6.2-6.8 L/100km.

El interior de 2.60m de largo permite transportar muebles alargados que no caben en la pequeña, como estanterías grandes, puertas o tableros. Y a diferencia de la grande, sigue siendo lo suficientemente compacta para acceder a zonas residenciales y parkings de altura estándar. Si no tienes claro qué tamaño elegir, la mediana resuelve el 80% de las necesidades de transporte en Alicante.`;

const related = [
  { name: "Furgoneta Pequeña", slug: "furgoneta-pequeña-alicante", icon: "🚐", price: "35€" },
  { name: "Furgoneta Grande", slug: "furgoneta-grande-alicante", icon: "🚚", price: "55€" },
  { name: "Furgoneta Extra Grande", slug: "furgoneta-extra-grande-alicante", icon: "🏗️", price: "65€" }
];
---

<ServiceDetailLayout
  title="Alquiler Furgoneta Mediana en Alicante"
  subtitle="El equilibrio perfecto entre capacidad y maniobrabilidad. Ideal para mudanzas medianas y transportes voluminosos."
  description={description}
  price="45€"
  vehicleType="mediana"
  breadcrumbLabel="Furgoneta Mediana"
  image="/images/furgonetas/mediana-hero.webp"
  specs={specs}
  idealFor={idealFor}
  includes={includes}
  related={related}
  metaTitle="Alquiler Furgoneta Mediana en Alicante | Desde 45€/día"
  metaDescription="Alquiler de furgonetas medianas en Alicante. Capacidad 6-7m³, 850 kg de carga. Ideal para mudanzas medianas. Precios desde 45€/día."
  product={{
    name: "Alquiler Furgoneta Mediana en Alicante",
    description: "Furgoneta mediana 6-7m³, 850 kg de carga útil. Perfecta para mudanzas medianas y transportes voluminosos.",
    capacity: "6-7m³",
    maxLoad: "850 kg",
    seats: "2-3 plazas",
    price: "45"
  }}
/>
